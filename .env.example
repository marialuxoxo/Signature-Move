# Schlüssel für den KI-Check (https://console.anthropic.com)
# Ohne Schlüssel läuft alles, nur der KI-Check ist ausgeblendet.
ANTHROPIC_API_KEY=

# Optional: anderes Claude-Modell verwenden
ANTHROPIC_MODEL=claude-sonnet-5

# Port des API-Servers
PORT=8787

# Nur für den Betrieb im Netz (z. B. bei Render):
# Webseiten, die den Server ansprechen dürfen, mit Komma getrennt
ALLOWED_ORIGINS=
# Höchstzahl KI-Checks pro Tag
DAILY_LIMIT=100
# Auf 1 setzen, wenn der Server hinter dem Proxy eines Hosters läuft
TRUST_PROXY=
